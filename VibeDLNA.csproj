<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VibeDLNA</AssemblyName>
    <RootNamespace>VibeDLNA</RootNamespace>
    <ApplicationIcon>Assets\VibeDLNA.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>VibeDLNA</Product>
    <Company>VibeDLNA</Company>
    <Description>Servidor DLNA para compartir carpetas en la red local.</Description>
    <RepositoryUrl>https://github.com/SPxMM3R/VibeDLNA</RepositoryUrl>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VibeDLNA.Tests" />
    <Compile Remove="VibeDLNA.Tests\**\*.cs" />
  </ItemGroup>

</Project>
